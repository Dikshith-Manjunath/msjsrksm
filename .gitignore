.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# Virtual Environment & Tooling
.venv/
venv/
ENV/
env/
.bin/
.node/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.mypy_cache/

# Databases & SQLite Temporary Files
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.db-journal
*.sqlite3-journal

# Environment variables & local secrets
.env
.env.local
.env.*.local
*.env

# IDEs & Editor Configuration
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.obsidian/

# Node & Frontend Build Artifacts
node_modules/
**/node_modules/
dist/
**/dist/
*.tsbuildinfo
.eslintcache

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel & Deployment Tooling
.vercel/
.vercel
out/
